# Required locally. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Leave DATABASE_URL empty to use SQLite locally.
DATABASE_URL=
DATABASE_PATH=cal_ai.db

# Set true only when serving over HTTPS.
COOKIE_SECURE=false

# Optional Google OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional comma-separated origins for a separately hosted frontend.
CORS_ORIGINS=

# Optional image analysis providers.
GEMINI_API_KEY=
OPENAI_API_KEY=
